{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluidcad",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_URL": "https://fluidcad.cf-7ad.workers.dev"
  },
  "containers": [
    {
      "class_name": "FluidCAD",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FLUIDCAD", "class_name": "FluidCAD" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FluidCAD"] }]
}
